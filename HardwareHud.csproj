<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HardwareHud</AssemblyName>
    <RootNamespace>HardwareHud</RootNamespace>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <!-- Beat Saber folder. Override it with: dotnet build -p:BeatSaberDir="..."
         or (recommended) create a HardwareHud.csproj.user file next to this one, see README.
         Dossier de Beat Saber. Remplace-le avec -p:BeatSaberDir="..." ou un fichier HardwareHud.csproj.user (voir README). -->
    <BeatSaberDir Condition=" '$(BeatSaberDir)' == '' ">D:\steam\steamapps\common\Beat Saber</BeatSaberDir>
    <Managed>$(BeatSaberDir)\Beat Saber_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="IPA.Loader"><HintPath>$(Managed)\IPA.Loader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HMLib"><HintPath>$(Managed)\HMLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HMUI"><HintPath>$(Managed)\HMUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Main"><HintPath>$(Managed)\Main.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BeatSaber.ViewSystem"><HintPath>$(Managed)\BeatSaber.ViewSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BSML"><HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(Managed)\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreModule"><HintPath>$(Managed)\UnityEngine.TextCoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(Managed)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="settings_*.bsml" />
  </ItemGroup>

  <!-- Copie le plugin dans Plugins\ et les dépendances dans Libs\ -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(BeatSaberDir)')">
    <ItemGroup>
      <PluginFile Include="$(OutDir)HardwareHud.dll" />
      <LibFile Include="$(OutDir)*.dll" Exclude="$(OutDir)HardwareHud.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(BeatSaberDir)\Plugins" />
    <Copy SourceFiles="@(LibFile)" DestinationFolder="$(BeatSaberDir)\Libs" />
  </Target>

</Project>
