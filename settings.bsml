<vertical xmlns="https://monkeymanboy.github.io/BSML-Docs/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd" pad="2" spacing="1">
  <tab-selector tab-tag="hwtabs" />

  <!-- Onglet 1 : quelles infos suivre -->
  <tab tags="hwtabs" tab-name="Infos suivies">
    <settings-container>
      <bool-setting text="Température CPU" value="showCpuTemp" apply-on-change="true" bind-value="true" hover-hint="Température + graphique du processeur" />
      <bool-setting text="Utilisation CPU" value="showCpuLoad" apply-on-change="true" bind-value="true" hover-hint="Utilisation + graphique du processeur" />
      <bool-setting text="Température GPU" value="showGpuTemp" apply-on-change="true" bind-value="true" hover-hint="Température + graphique de la carte graphique" />
      <bool-setting text="Utilisation GPU" value="showGpuLoad" apply-on-change="true" bind-value="true" hover-hint="Utilisation + graphique de la carte graphique" />
      <bool-setting text="VRAM utilisée" value="showVram" apply-on-change="true" bind-value="true" hover-hint="Mémoire vidéo utilisée / totale + graphique" />
      <bool-setting text="Température VRAM" value="showVramTemp" apply-on-change="true" bind-value="true" hover-hint="Température de la mémoire vidéo (si la carte la fournit)" />
    </settings-container>
  </tab>

  <!-- Onglet 2 : seuils de couleur -->
  <tab tags="hwtabs" tab-name="Seuils de couleur">
    <settings-container>
      <slider-setting text="CPU orange à (°C)" value="cpuWarnTemp" min="40" max="110" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Au-dessus : la température CPU passe à l'orange" />
      <slider-setting text="CPU rouge à (°C)" value="cpuHotTemp" min="40" max="110" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Au-dessus : la température CPU passe au rouge" />
      <slider-setting text="GPU orange à (°C)" value="gpuWarnTemp" min="40" max="110" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Au-dessus : la température GPU passe à l'orange" />
      <slider-setting text="GPU rouge à (°C)" value="gpuHotTemp" min="40" max="110" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Au-dessus : la température GPU passe au rouge" />
      <slider-setting text="VRAM orange à (°C)" value="vramWarnTemp" min="40" max="120" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Au-dessus : la température VRAM passe à l'orange" />
      <slider-setting text="VRAM rouge à (°C)" value="vramHotTemp" min="40" max="120" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Au-dessus : la température VRAM passe au rouge" />
    </settings-container>
  </tab>

  <!-- Onglet 3 : couleurs d'utilisation -->
  <tab tags="hwtabs" tab-name="Couleur utilisation">
    <settings-container>
      <bool-setting text="Colorer les utilisations" value="colorLoad" apply-on-change="true" bind-value="true" hover-hint="CPU/GPU Usage et VRAM passent à l'orange puis au rouge selon les seuils" />
      <slider-setting text="Orange à (%)" value="loadWarn" min="10" max="100" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Seuil orange des utilisations (en % de charge ou de VRAM)" />
      <slider-setting text="Rouge à (%)" value="loadHot" min="10" max="100" increment="1" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Seuil rouge des utilisations (en % de charge ou de VRAM)" />
    </settings-container>
  </tab>

  <!-- Onglet 4 : affichage -->
  <tab tags="hwtabs" tab-name="Affichage">
    <settings-container>
      <bool-setting text="Afficher dans le menu" value="showInMenu" apply-on-change="true" bind-value="true" hover-hint="Panneau visible dans les menus" />
      <bool-setting text="Afficher en partie" value="showInSong" apply-on-change="true" bind-value="true" hover-hint="Panneau visible pendant les maps" />
      <slider-setting text="Opacité du fond" value="opacity" min="0.1" max="1" increment="0.05" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Transparence du fond du panneau" />
      <slider-setting text="Rafraîchissement (ms)" value="interval" min="250" max="5000" increment="250" show-buttons="true" apply-on-change="true" bind-value="true" hover-hint="Fréquence de lecture des capteurs (plus bas = plus réactif)" />
    </settings-container>
  </tab>
</vertical>
